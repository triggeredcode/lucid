*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
# generated PDFs are not committed
*.pdf

# playwright
playwright-report/
test-results/

# fetched at build time (scripts/fetch-tectonic.mjs)
apps/desktop/resources/bin/

# packaged app
apps/desktop/release/

# GitHub Pages site (scripts/build-site.mjs)
_site/
