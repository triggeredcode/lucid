# dependencies and build output
node_modules/
dist/
out/
build/
coverage/
*.tsbuildinfo

# OS / editor
.DS_Store
.idea/
.vscode/

# local agent settings
.claude/settings.local.json

# env and secrets
.env
.env.*
!.env.example

# Lucid runtime data and exports (never commit user notes)
